			x: 11.0d
			y: 4.5d
		}
		{
			dependencies: ["34847A93057851E3"]
			description: [
				"Die Injection Chamber verarbeitet einen Erzblock mit Hydrogen Chloride zu vier &eShards&r. Gebaut wird sie aus einer Purification Chamber."
				"Kette: Erz → Injection Chamber → Shards → Purification Chamber → Clumps → Crusher → Dirty Dust → Enrichment Chamber → Dust → Ofen."
				"Jede Stufe hängt sich vorn an die vorige. Die alten Maschinen bleiben in der Kette."
			]
			hide_until_deps_visible: true
			icon: "mekanism:shard_iron"
