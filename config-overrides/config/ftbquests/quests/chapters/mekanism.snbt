		{
			dependencies: ["12617912326846AC"]
			description: [
				"Osmium ist das Metall, um das sich in Mekanism alles dreht: Maschinen, Schaltkreise, Tanks und Upgrades brauchen es. In der Overworld ist es selten, ungefähr so häufig wie Diamant, und liegt in allen Höhen. Für den Anfang reichen ein paar Barren. &6⚙&r Später gibt es Osmium reichlich in Everdawn und auf dem Mond."
			]
			hide_until_deps_visible: true
			icon: "mekanism:raw_osmium"
			id: "75C91E77E306DEEC"
			subtitle: "MK1 · Infuser und Sauerstoff"
			tasks: [{
				id: "4B75EABC71B87420"
				item: { Count: 1b, id: "ftbfiltersystem:smart_filter", tag: { "ftbfiltersystem:filter": "or(item(mekanism:raw_osmium)item(mekanism:ingot_osmium))" } }
				title: "Raw Osmium oder Osmium Ingot"
				type: "item"
			}]
			title: "Osmium"
			x: 0.5d
			y: 0.0d
		}
		{
			dependencies: ["75C91E77E306DEEC"]
			description: [
				"Die erste Maschine von Mekanism. Sie lädt einen Stoff in ein Item: links das Item, rechts der Stoff, etwa Redstone oder Kohle. Ein Redstone-Staub ergibt 10 Einheiten Redstone, eine Kohle 10 Carbon, eine Holzkohle 20."
				"Rezept: 4 Eisen, 2 Furnace, 2 Redstone, 1 Osmium Ingot."
				"Die Maschine braucht Strom. Hast du noch keinen, bau zuerst den Heat Generator (nächste Quest)."
			]
			hide_until_deps_visible: true
			icon: "mekanism:metallurgic_infuser"
			id: "4BC3380EC1235A5D"
			subtitle: "MK1 · Infuser und Sauerstoff"
			tasks: [{
				id: "3DBA56CBE8853FC5"
				item: "mekanism:metallurgic_infuser"
				type: "item"
			}]
			title: "Metallurgic Infuser"
			x: -0.25d
			y: 1.5d
		}
		{
			dependencies: ["75C91E77E306DEEC"]
			description: [
				"Der einfachste Generator: Er verbrennt Brennstoff wie Kohle oder Holz und liefert 200 Joule je Tick. Steht Lava an einer Seite, kommen je Seite 30 Joule dazu, im Nether 100. Er braucht keinen Stahl."
				"Mekanism rechnet in Joule, nimmt aber auch Strom von Immersive Engineering an. Ein IE-Generator tut es also auch."
			]
			hide_until_deps_visible: true
			icon: "mekanismgenerators:heat_generator"
			id: "297CC840928521E9"
			subtitle: "MK1 · Infuser und Sauerstoff"
			tasks: [{
				id: "1EDAEBD24385AF8D"
				item: "mekanismgenerators:heat_generator"
				type: "item"
			}]
			title: "Heat Generator"
			x: 1.25d
			y: 1.5d
		}
		{
			dependencies: ["4BC3380EC1235A5D", "297CC840928521E9"]
			description: [
				"Mit dem Infuser entstehen die Grundstoffe des Mods:"
				"• &eInfused Alloy:&r Eisenbarren + 10 Redstone."
				"• &eBasic Control Circuit:&r Osmium Ingot + 20 Redstone. Der Schaltkreis steckt in fast jeder Maschine."
				"• &eStahl:&r Eisenbarren + 10 Carbon ergibt Enriched Iron, Enriched Iron + 10 Carbon ergibt Steel Dust, im Ofen geschmolzen ein Steel Ingot."
				"Stahl aus Immersive Engineering passt in jedes Mekanism-Rezept und umgekehrt."
			]
			hide_until_deps_visible: true
			icon: "mekanism:alloy_infused"
			id: "67B226B1E72E2FD3"
			subtitle: "MK1 · Infuser und Sauerstoff"
