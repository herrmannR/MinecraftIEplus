		{
			dependencies: ["67B226B1E72E2FD3"]
			description: [
				"Das Gehäuse sitzt in der Mitte fast jedes Maschinenrezepts. Rezept: 4 Stahl, 4 Glass, 1 Osmium Ingot. Bau dir gleich ein paar auf Vorrat."
			]
			hide_until_deps_visible: true
