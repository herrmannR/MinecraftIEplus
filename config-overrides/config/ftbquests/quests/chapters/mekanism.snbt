		{
			dependencies: ["7B9237C64623DC2D"]
			description: [
				"1. Yellow Cake im Chemical Oxidizer: &eUranium Oxide&r."
				"2. Fluorit in der Dissolution Chamber mit Sulfuric Acid: &eHydrofluoric Acid&r."
				"3. Uranium Oxide + Hydrofluoric Acid im Chemical Infuser: &eUranium Hexafluoride&r."
				"4. In der &eIsotopic Centrifuge&r: &eFissile Fuel&r."
				"&6⚙&r Fluorit liegt in der Overworld und reichlich auf dem Mars. Blei für die Zentrifuge kommt aus Everbright, vom Merkur oder von der Venus."
			]
			hide_until_deps_visible: true
			icon: "mekanism:isotopic_centrifuge"
